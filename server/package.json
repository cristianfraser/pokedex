{
  "name": "pokedex-server",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.0.2",
  "scripts": {
    "preinstall": "corepack enable",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "image-seed": "tsx src/scripts/image-seed.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "migrate:stat-short-names": "tsx src/db/migrations/add-stat-short-names.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
